{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FES ROM map format 1",
  "description": "Cyclone V maps encode CRAM destinations. Nano held-ROM maps bind separate CPU-fed firmware delivery and contain no physical addresses or patch locations. Readers additionally enforce exact scalar types, manifest bindings and encoding-specific bounds.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "device",
        "encoding",
        "base_sha256",
        "source_size",
        "blocks"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "device": {
          "const": "5CSEBA6U23I7"
        },
        "encoding": {
          "const": "m10k-1024x10-v1"
        },
        "base_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "source_size": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144,
          "multipleOf": 1024
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bel",
              "source_offset",
              "word_bits"
            ],
            "properties": {
              "bel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "x-fes-maxUtf8Bytes": 64,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
              },
              "source_offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 261120,
                "multipleOf": 1024
              },
              "word_bits": {
                "type": "array",
                "minItems": 256,
                "maxItems": 256,
                "items": {
                  "type": "array",
                  "minItems": 40,
                  "maxItems": 40,
                  "items": {
                    "type": "integer",
                    "minimum": 243360,
                    "maximum": 53417519
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "device",
        "encoding",
        "base_sha256",
        "source_size"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "device": {
          "const": "A5EB013BB23BE4SCS"
        },
        "encoding": {
          "const": "cpu-csr-v1"
        },
        "base_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "source_size": {
          "type": "integer",
          "enum": [
            4096,
            8192
          ]
        }
      }
    }
  ]
}
