set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name SYSTEMVERILOG_FILE top.sv
set_global_assignment -name SDC_FILE clocks.sdc
set_instance_assignment -name HPS_LOCATION HPSINTERFACEPERIPHERALI2C_X52_Y60_N111 -to hdmi_i2c
set_location_assignment PIN_U10 -to HDMI_I2C_SCL
set_location_assignment PIN_AA4 -to HDMI_I2C_SDA
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "HDMI_I2C_*"
set_instance_assignment -name CURRENT_STRENGTH_NEW "16MA" -to "HDMI_I2C_*"
set_instance_assignment -name SLEW_RATE 1 -to "HDMI_I2C_*"
set_instance_assignment -name BOARD_MODEL_FAR_C 0P -to "HDMI_I2C_*"
set_global_assignment -name AUTO_OPEN_DRAIN_PINS OFF
