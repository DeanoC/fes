`verilator_config
// Lint that Verilator 5.054 raises on simulation builds 5.032 accepted.
// scripts/verilator_waivers.py passes this file only to a Verilator that
// knows every rule it names; older ones reject unknown rule names. pcxt and
// pc386 keep their own lint configuration.
//
// PROCASSINIT: a register declared with an initial value and then assigned
// in an always block. That initial value is the FPGA power-on state the
// cores rely on, so every hit in these files is intended. Waived per file.
lint_off -rule PROCASSINIT -file "*/fes-apple2/expansions/probe.v"
lint_off -rule PROCASSINIT -file "*/fes-apple2/rtl/apple2_audio.v"
lint_off -rule PROCASSINIT -file "*/fes-apple2/rtl/apple2_disk2_card.v"
lint_off -rule PROCASSINIT -file "*/fes-apple2/rtl/apple2_disk2_drive.v"
lint_off -rule PROCASSINIT -file "*/fes-apple2/rtl/apple2_keyboard.v"
lint_off -rule PROCASSINIT -file "*/fes-apple2/rtl/apple2_machine.sv"
lint_off -rule PROCASSINIT -file "*/fes-apple2/rtl/apple2_slot_sockets.v"
lint_off -rule PROCASSINIT -file "*/fes-apple2/rtl/apple2_video.v"
lint_off -rule PROCASSINIT -file "*/fes-atari-st/rtl/st_video.sv"
lint_off -rule PROCASSINIT -file "*/fes-atari-st/rtl/st_video_socket.sv"
lint_off -rule PROCASSINIT -file "*/fes-atari-st/sim/st_memory_sim_top.sv"
lint_off -rule PROCASSINIT -file "*/fes-atari-st/sim/st_video_adapter_sim_top.sv"
lint_off -rule PROCASSINIT -file "*/fes-atari-st/sim/st_video_sim_top.sv"
lint_off -rule PROCASSINIT -file "*/fes-c64/rtl/c64_vic.v"
lint_off -rule PROCASSINIT -file "*/fes-c64/sim/session_video_top.sv"
lint_off -rule PROCASSINIT -file "*/fes-coleco/expansions/diagnostic.v"
lint_off -rule PROCASSINIT -file "*/fes-coleco/expansions/sgm_ay.v"
lint_off -rule PROCASSINIT -file "*/fes-coleco/expansions/sgm_control.v"
lint_off -rule PROCASSINIT -file "*/fes-coleco/rtl/coleco_expansion_socket_v2.v"
lint_off -rule PROCASSINIT -file "*/fes-coleco/rtl/coleco_machine.sv"
lint_off -rule PROCASSINIT -file "*/fes-coleco/rtl/coleco_megacart_rom.v"
lint_off -rule PROCASSINIT -file "*/fes-coleco/rtl/coleco_native_video_socket.v"
lint_off -rule PROCASSINIT -file "*/fes-coleco/rtl/coleco_video_socket.v"
lint_off -rule PROCASSINIT -file "*/fes-coleco/sim/session_harness.v"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/coleco_native_video.v"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/cpu6502/cpu6502.v"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/fes_application_gp.v"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/fes_audio_i2s.v"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/fes_audio_output.v"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/fes_computer_mailbox.v"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/fes_display_cdc.v"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/fes_display_plane.v"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/fes_hps_ddr.v"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/fes_hps_ddr_guard.v"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/fes_native_cdc.v"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/fes_native_video.v"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/fes_sn76489.sv"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/fes_video_part_scanlines.v"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/fes_z80_ce.sv"
lint_off -rule PROCASSINIT -file "*/fes-common/rtl/z80/fes_z80_nmos.sv"
lint_off -rule PROCASSINIT -file "*/fes-common/sim/display_plane_top.v"
lint_off -rule PROCASSINIT -file "*/fes-menu/rtl/fes_menu_blend.v"
lint_off -rule PROCASSINIT -file "*/fes-menu/rtl/fes_menu_blit_alpha.v"
lint_off -rule PROCASSINIT -file "*/fes-menu/rtl/fes_menu_blit_control.v"
lint_off -rule PROCASSINIT -file "*/fes-menu/rtl/fes_menu_blit_read.v"
lint_off -rule PROCASSINIT -file "*/fes-menu/rtl/fes_menu_blitter.v"
