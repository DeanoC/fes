`verilator_config
// Vendor-scoped waivers only; the pc386 RTL stays under fatal lint.
lint_off -rule WIDTH -file "*/vendor/kf825*/*.sv"
lint_off -rule UNUSEDSIGNAL -file "*/vendor/kf825*/*.sv"
lint_off -rule COMBDLY -file "*/vendor/kf825*/*.sv"
lint_off -rule VARHIDDEN -file "*/vendor/kf8253/*.sv"
// The imported chips assert reset asynchronously; the AT core drives the
// machine reset synchronously and holds it for several clocks.
lint_off -rule SYNCASYNCNET -file "*/rtl/pc386_at_core.sv" -match "*reset*"
lint_off -rule SYNCASYNCNET -file "*/rtl/pc386_machine.sv" -match "*reset*"
// The shared display plane leaves its scanout's own raster outputs open.
lint_off -rule PINCONNECTEMPTY -file "*/fes-common/rtl/fes_display_plane.v"
lint_off -rule PINCONNECTEMPTY -file "*/fes-menu/rtl/fes_menu_video.v"
