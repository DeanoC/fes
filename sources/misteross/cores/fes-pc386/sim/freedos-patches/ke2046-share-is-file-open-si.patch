fes#1777: FreeDOS kernel 2046's SHARE_IS_FILE_OPEN (INT 2Fh AX=10A6h) returns
with SI holding DS, but its Watcom pascal callers expect SI kept, and
DosRenameTrue holds path1 in SI across the call. Once SHARE answers 10A6h,
every rename then works on a garbage path. This version saves SI and DS on
the stack and reads the filename through BX (which pascal callers let it
change), in the 18 bytes the old stub took, so the rest of the kernel keeps
its layout.

Upstream: https://github.com/FDOS/kernel/issues/276 (SHARE side:
https://github.com/FDOS/share/issues/27). Drop this patch, and build from
the upstream release, once FDOS/kernel ships a fix.

Applies with patch -p1 to ke2046s.zip's SOURCE/ke2046 (CRLF lines).

--- a/kernel/int2f.asm
+++ b/kernel/int2f.asm
@@ -357,17 +357,15 @@
 ; STATIC WORD share_is_file_open(const char far *filename) /* pointer to fully qualified filename */
 		global SHARE_IS_FILE_OPEN
 SHARE_IS_FILE_OPEN:
-		mov	si, ds
-		mov	es, si		; save ds
-		pop	ax		; save return address
-		pop	si		; filename
-		pop	ds		; SEG filename
-		push	ax		; restore return address
+		push	si		; callers keep values in si (DosRenameTrue: path1)
+		push	ds
+		mov	bx, sp
+		lds	si, [ss:bx+6]	; filename, past ds, si and the return address
 		mov	ax, 0x10a6
-		int	0x2f	     	; returns ax
-		mov	si, es		; restore ds
-		mov	ds, si
-		ret
+		int	0x2f		; returns ax
+		pop	ds
+		pop	si
+		ret	4
 
 ; Int 2F Multipurpose Remote System Calls
 ;
