`verilator_config
// Preserve upstream bytes. These waivers apply only to the pinned CPU files:
// implicit zero extension/truncation and unused internal debug/decode wires.
lint_off -rule WIDTH -file "*/vendor/mcl86/*.sv"
lint_off -rule UNUSEDSIGNAL -file "*/vendor/mcl86/*.sv"

// Lint new in 5.054, signal by signal. SIMILARNAME: the upstream CPU
// declares these names twice, differing only in case. Upstream bytes stay.
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_biu_max.sv" -match "*'biu_register_cs'*"
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_biu_max.sv" -match "*'biu_register_ds'*"
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_biu_max.sv" -match "*'biu_register_es'*"
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_biu_max.sv" -match "*'biu_register_reg'*"
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_biu_max.sv" -match "*'biu_register_rm'*"
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_biu_max.sv" -match "*'biu_register_ss'*"
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_biu_max.sv" -match "*'biu_segment'*"
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_biu_max.sv" -match "*'eu_biu_strobe'*"
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_biu_max.sv" -match "*'pfq_addr_out'*"
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_biu_max.sv" -match "*'pfq_empty'*"
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_eu_core.sv" -match "*'eu_biu_command'*"
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_eu_core.sv" -match "*'eu_biu_dataout'*"
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_eu_core.sv" -match "*'eu_flag_i'*"
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_eu_core.sv" -match "*'eu_prefix_lock'*"
lint_off -rule SIMILARNAME -file "*/vendor/mcl86/mcl86_eu_core.sv" -match "*'eu_register_r3'*"
// PROCASSINIT: power-on initial values on registers the logic also assigns.
// The memory and video suites load this file without chipset.vlt.
lint_off -rule PROCASSINIT -file "*/sim/memory_top.sv" -match "*'high_data'*"
lint_off -rule PROCASSINIT -file "*/sim/memory_top.sv" -match "*'low_data'*"
lint_off -rule PROCASSINIT -file "*/sdram_addon_port.v" -match "*'held_addr'*"
lint_off -rule PROCASSINIT -file "*/sdram_addon_port.v" -match "*'held_byte_enable'*"
lint_off -rule PROCASSINIT -file "*/sdram_addon_port.v" -match "*'held_data'*"
lint_off -rule PROCASSINIT -file "*/sdram_addon_port.v" -match "*'init_hi'*"
lint_off -rule PROCASSINIT -file "*/sdram_addon_port.v" -match "*'initialized'*"
lint_off -rule PROCASSINIT -file "*/sdram_addon_port.v" -match "*'ref_hi'*"
lint_off -rule PROCASSINIT -file "*/sdram_addon_port.v" -match "*'refresh_div'*"
lint_off -rule PROCASSINIT -file "*/sdram_addon_port.v" -match "*'refresh_due'*"
lint_off -rule PROCASSINIT -file "*/sdram_addon_port.v" -match "*'refresh_with_request'*"
lint_off -rule PROCASSINIT -file "*/sdram_addon_port.v" -match "*'seen'*"
lint_off -rule PROCASSINIT -file "*/sdram_addon_port.v" -match "*'state'*"
lint_off -rule PROCASSINIT -file "*/sdram_addon_port.v" -match "*'wait_count'*"
lint_off -rule PROCASSINIT -file "*/sdram_addon_port.v" -match "*'writing'*"
lint_off -rule PROCASSINIT -file "*/fes_video_part_scanlines.v" -match "*'odd_line'*"
