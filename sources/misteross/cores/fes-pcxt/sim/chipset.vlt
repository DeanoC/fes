`verilator_config
// Vendor-scoped waivers only; handwritten wrappers remain under fatal lint.
lint_off -rule WIDTH -file "*/vendor/kf825*/*.sv"
lint_off -rule UNUSEDSIGNAL -file "*/vendor/kf825*/*.sv"
lint_off -rule COMBDLY -file "*/vendor/kf825*/*.sv"
lint_off -rule VARHIDDEN -file "*/vendor/kf8253/*.sv"
// Imported chips assert reset asynchronously; the fixture drives the shared
// reset synchronously and holds it for multiple fabric clocks.
lint_off -rule SYNCASYNCNET -file "*/sim/motherboard_top.sv" -match "*reset*"
lint_off -rule SYNCASYNCNET -file "*/sim/machine_top.sv" -match "*reset*"
// Same fixture reset drives synchronous FES RTL and asynchronous imported chips.
lint_off -rule SYNCASYNCNET -file "*/sim/display_machine_top.sv" -match "*reset*"

lint_off -rule SYNCASYNCNET -file "*/sim/video_machine_top.sv" -match "*reset*"

// The SDRAM fixture shares the same imported-chip reset boundary.
lint_off -rule SYNCASYNCNET -file "*/sim/memory_machine_top.sv" -match "*reset*"

// Production machine reset also reaches the imported asynchronous chips.
lint_off -rule SYNCASYNCNET -file "*/rtl/pcxt_machine.sv" -match "*reset*"
lint_off -rule SYNCASYNCNET -file "*/sim/system_top.sv" -match "*machine_reset*"
// The BIOS fixture observes the same synchronous-FES/asynchronous-vendor boundary.
lint_off -rule SYNCASYNCNET -file "*/sim/bios_top.sv" -match "*machine_reset*"
