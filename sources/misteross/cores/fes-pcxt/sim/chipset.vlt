`verilator_config
// Vendor-scoped waivers only; handwritten wrappers remain under fatal lint.
lint_off -rule WIDTH -file "*/vendor/kf825*/*.sv"
lint_off -rule UNUSEDSIGNAL -file "*/vendor/kf825*/*.sv"
lint_off -rule COMBDLY -file "*/vendor/kf825*/*.sv"
lint_off -rule VARHIDDEN -file "*/vendor/kf8253/*.sv"
// Imported chips assert reset asynchronously; the fixture drives the shared
// reset synchronously and holds it for multiple fabric clocks.
lint_off -rule SYNCASYNCNET -file "*/sim/motherboard_top.sv" -match "*reset*"
lint_off -rule SYNCASYNCNET -file "*/sim/machine_top.sv" -match "*reset*"
// Same fixture reset drives synchronous FES RTL and asynchronous imported chips.
lint_off -rule SYNCASYNCNET -file "*/sim/display_machine_top.sv" -match "*reset*"

lint_off -rule SYNCASYNCNET -file "*/sim/video_machine_top.sv" -match "*reset*"

// The SDRAM fixture shares the same imported-chip reset boundary.
lint_off -rule SYNCASYNCNET -file "*/sim/memory_machine_top.sv" -match "*reset*"

// Production machine reset also reaches the imported asynchronous chips.
lint_off -rule SYNCASYNCNET -file "*/rtl/pcxt_machine.sv" -match "*reset*"
lint_off -rule SYNCASYNCNET -file "*/sim/system_top.sv" -match "*machine_reset*"
// The BIOS fixture observes the same synchronous-FES/asynchronous-vendor boundary.
lint_off -rule SYNCASYNCNET -file "*/sim/bios_top.sv" -match "*machine_reset*"

// Verilator 5.054 PROCASSINIT, signal by signal: power-on initial values on
// registers the logic also assigns. Older releases do not know the rule.
lint_off -rule PROCASSINIT -file "*/rtl/pcxt_machine.sv" -match "*'reset_fast'*"
lint_off -rule PROCASSINIT -file "*/rtl/pcxt_machine.sv" -match "*'reset_phase'*"
lint_off -rule PROCASSINIT -file "*/rtl/pcxt_media.sv" -match "*'previous_state'*"
lint_off -rule PROCASSINIT -file "*/rtl/pcxt_media_arbiter.sv" -match "*'held_read_address'*"
lint_off -rule PROCASSINIT -file "*/rtl/pcxt_media_arbiter.sv" -match "*'prefer_snapshot'*"
lint_off -rule PROCASSINIT -file "*/rtl/pcxt_media_arbiter.sv" -match "*'read_snapshot'*"
lint_off -rule PROCASSINIT -file "*/rtl/pcxt_media_arbiter.sv" -match "*'read_state'*"
lint_off -rule PROCASSINIT -file "*/rtl/pcxt_media_arbiter.sv" -match "*'write_guest'*"
lint_off -rule PROCASSINIT -file "*/rtl/pcxt_media_arbiter.sv" -match "*'write_state'*"
lint_off -rule PROCASSINIT -file "*/rtl/pcxt_memory.sv" -match "*'reset_pipe'*"
lint_off -rule PROCASSINIT -file "*/rtl/pcxt_sector_writer.sv" -match "*'lba'*"
lint_off -rule PROCASSINIT -file "*/rtl/pcxt_sector_writer.sv" -match "*'state'*"
lint_off -rule PROCASSINIT -file "*/rtl/pcxt_system.sv" -match "*'machine_reset'*"
lint_off -rule PROCASSINIT -file "*/fes_computer_mailbox.v" -match "*'media_reset_pipe'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_i2s.v" -match "*'left'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_i2s.v" -match "*'phase'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_i2s.v" -match "*'right'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_i2s.v" -match "*'sdata'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_output.v" -match "*'ack_meta'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_output.v" -match "*'acknowledge'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_output.v" -match "*'ack_sync'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_output.v" -match "*'held_sample'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_output.v" -match "*'hold_meta'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_output.v" -match "*'hold_sync'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_output.v" -match "*'lock_meta'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_output.v" -match "*'lock_sync'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_output.v" -match "*'pcm'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_output.v" -match "*'request'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_output.v" -match "*'request_meta'*"
lint_off -rule PROCASSINIT -file "*/fes_audio_output.v" -match "*'request_sync'*"
// Self-checking testbenches for the sector writer and media arbiter.
lint_off -rule PROCASSINIT -file "*/sim/sector_writer_tb.sv" -match "*'changes'*"
lint_off -rule PROCASSINIT -file "*/sim/sector_writer_tb.sv" -match "*'clk'*"
lint_off -rule PROCASSINIT -file "*/sim/sector_writer_tb.sv" -match "*'completions'*"
lint_off -rule PROCASSINIT -file "*/sim/sector_writer_tb.sv" -match "*'cycle'*"
lint_off -rule PROCASSINIT -file "*/sim/sector_writer_tb.sv" -match "*'delay_count'*"
lint_off -rule PROCASSINIT -file "*/sim/sector_writer_tb.sv" -match "*'held_address'*"
lint_off -rule PROCASSINIT -file "*/sim/sector_writer_tb.sv" -match "*'held_data'*"
lint_off -rule PROCASSINIT -file "*/sim/sector_writer_tb.sv" -match "*'offers'*"
lint_off -rule PROCASSINIT -file "*/sim/sector_writer_tb.sv" -match "*'pending'*"
lint_off -rule PROCASSINIT -file "*/sim/sector_writer_tb.sv" -match "*'sector_data'*"
lint_off -rule PROCASSINIT -file "*/sim/media_arbiter_tb.sv" -match "*'clk'*"
