# Minimal Quartus project for the 050_lut_mul oracle.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name VERILOG_FILE "../../../experiments/050_lut_mul/rtl/top.v"
set_global_assignment -name SDC_FILE "../../../boards/de10nano/clocks.sdc"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY "output_files"
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name IGNORE_PARTITIONS ON

# The product is observed through the HPS GP interface.  Keep the shared 50 MHz
# clock assignment explicit in the oracle project and do not source unrelated
# board constraints.
set_location_assignment PIN_V11 -to FPGA_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FPGA_CLK1_50
