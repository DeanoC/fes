# 50 MHz reference and dedicated SDR registered output on PIN_W15.
set_location_assignment PIN_V11 -to FPGA_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FPGA_CLK1_50
set_location_assignment PIN_W15 -to SDR_OUT
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SDR_OUT
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to SDR_OUT
