#!/bin/sh
set -eu

supervisor_pid=/run/mister-agent-supervisor.pid

stop_service() {
  [ -f "$supervisor_pid" ] || return 0
  IFS= read -r pid < "$supervisor_pid"
  /bin/kill "$pid" 2>/dev/null || true
  stop_wait=5
  while /bin/kill -0 "$pid" 2>/dev/null && [ "$stop_wait" -gt 0 ]; do
    /bin/sleep 1
    stop_wait=$((stop_wait - 1))
  done
  /bin/rm -f "$supervisor_pid"
}

case "${1:-start}" in
  start)
    wait_seconds=30
    while [ ! -f /media/fat/mister-remote/agent.toml ] && [ "$wait_seconds" -gt 0 ]; do
      /bin/sleep 1
      wait_seconds=$((wait_seconds - 1))
    done
    if [ ! -f /media/fat/mister-remote/agent.toml ]; then
      printf '%s\n' 'mister-agent: writable FAT configuration did not appear within 30 seconds' >&2
      exit 1
    fi
    # VFAT may synthesize Unix mode bits; this chmod is a best-effort request,
    # not an enforced privacy boundary. Task 15 covers target mount masks and
    # Samba/SSH guest-access assertions.
    /bin/mkdir -p /media/fat/fogcast/cache/megadrive /media/fat/fogcast/cache/snes
    /bin/chmod 0700 /media/fat/fogcast/cache /media/fat/fogcast/cache/megadrive /media/fat/fogcast/cache/snes

    wait_seconds=30
    while [ ! -p /dev/MiSTer_cmd ] && [ "$wait_seconds" -gt 0 ]; do
      /bin/sleep 1
      wait_seconds=$((wait_seconds - 1))
    done
    if [ ! -p /dev/MiSTer_cmd ]; then
      printf '%s\n' 'mister-agent: /dev/MiSTer_cmd did not appear within 30 seconds' >&2
      exit 1
    fi
    agent_binary=/media/fat/mister-remote/mister-agent
    if [ ! -x "$agent_binary" ]; then
      printf '%s\n' 'mister-agent: FAT-side agent binary is missing or not executable' >&2
      exit 1
    fi
    /usr/sbin/mister-supervise mister-agent "$agent_binary" --config /media/fat/mister-remote/agent.toml &
    printf '%s\n' "$!" > "$supervisor_pid"
    ;;
  stop)
    stop_service
    ;;
  restart)
    stop_service
    "$0" start
    ;;
  *)
    printf 'usage: %s start|stop|restart\n' "$0" >&2
    exit 2
    ;;
esac
