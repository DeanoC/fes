#!/bin/sh
set -eu

main=/media/fat/MiSTer
menu=/media/fat/menu.rbf
main_pid=/run/mister-main.pid

verify_file() {
  verify_path=$1
  [ -f "$verify_path" ] || {
    printf 'mister-main: required artifact is missing: %s\n' "$verify_path" >&2
    exit 1
  }
  [ -s "$verify_path" ] || {
    printf 'mister-main: required artifact is empty: %s\n' "$verify_path" >&2
    exit 1
  }
}

stop_service() {
  [ -f "$main_pid" ] || return 0
  IFS= read -r pid < "$main_pid"
  /bin/kill "$pid" 2>/dev/null || true
  stop_wait=5
  while /bin/kill -0 "$pid" 2>/dev/null && [ "$stop_wait" -gt 0 ]; do
    /bin/sleep 1
    stop_wait=$((stop_wait - 1))
  done
  /bin/rm -f "$main_pid"
}

case "${1:-start}" in
  start)
    wait_seconds=10
    waiting_logged=0
    while { [ ! -f "$main" ] || [ ! -f "$menu" ]; } && [ "$wait_seconds" -gt 0 ]; do
      if [ "$waiting_logged" -eq 0 ]; then
        printf '%s\n' 'mister-main: waiting for /media/fat payloads'
        waiting_logged=1
      fi
      /bin/sleep 1
      wait_seconds=$((wait_seconds - 1))
    done
    verify_file "$main"
    verify_file "$menu"
    cd /media/fat
    /media/fat/MiSTer /media/fat/menu.rbf >> /var/log/mister-main.log 2>&1 &
    printf '%s\n' "$!" > "$main_pid"
    ;;
  stop)
    stop_service
    ;;
  restart)
    stop_service
    "$0" start
    ;;
  *)
    printf 'usage: %s start|stop|restart\n' "$0" >&2
    exit 2
    ;;
esac
