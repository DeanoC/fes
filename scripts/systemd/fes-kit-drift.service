[Unit]
Description=Flag unrecorded FES development-kit file changes
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=deano
Group=deano
WorkingDirectory=/home/deano/fes
Environment=FES_KIT_SSH_PASSWORD=1
# Hold markers and drift snapshots use the same durable per-user default as
# an interactive `fes kit watch` (~/.local/state/fes-kit). Do not point this
# unit at a separate directory; the first timer cycle must see a manual snapshot.
ExecStart=/home/deano/fes/scripts/fes kit watch --once
# FES_KIT_SSH_PASSWORD is the documented development-image login.
