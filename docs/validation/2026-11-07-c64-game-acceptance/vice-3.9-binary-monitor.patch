+/* Local fes#1531 reference patch: press or release one C64 keyboard matrix switch (row, column, value). */
+static void monitor_binary_process_keymatrix_set(binary_command_t *command)
+{
+    if (command->length < 3) {
+        monitor_binary_error(e_MON_ERR_CMD_INVALID_LENGTH, command->request_id);
+        return;
+    }
+    keyboard_set_keyarr_any(command->body[0], command->body[1], command->body[2]);
+    monitor_binary_response(0, e_MON_RESPONSE_KEYMATRIX_SET, e_MON_ERR_OK, command->request_id, NULL);
+}
+
+/* Local fes#1531 reference patch: set the emulated joystick on a port (JOYPORT_1 = 0) to an absolute value. */
+static void monitor_binary_process_joystick_set(binary_command_t *command)
+{
+    if (command->length < 2) {
+        monitor_binary_error(e_MON_ERR_CMD_INVALID_LENGTH, command->request_id);
+        return;
+    }
+    joystick_set_value_absolute(command->body[0], command->body[1]);
+    monitor_binary_response(0, e_MON_RESPONSE_JOYSTICK_SET, e_MON_ERR_OK, command->request_id, NULL);
+}
