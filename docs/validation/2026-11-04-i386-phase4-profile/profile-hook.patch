diff -ruN a/sources/misteross/cores/fes-pc386/sim/cpu_profile_window.py b/sources/misteross/cores/fes-pc386/sim/cpu_profile_window.py
--- a/sources/misteross/cores/fes-pc386/sim/cpu_profile_window.py	1970-01-01 02:00:00.000000000 +0200
+++ b/sources/misteross/cores/fes-pc386/sim/cpu_profile_window.py	2026-11-05 02:02:38.964749051 +0200
@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Phase 4 profile window (scratch): analyse.py cpu.prof FROM TO [--json OUT]
+
+FROM/TO are dump times (simulated seconds). Prints the window's clock buckets, its
+classes and its derived costs; --json writes the same numbers."""
+import json
+import sys
+from collections import defaultdict
+
+
+def load(path):
+    t, b, c, s = {}, {}, defaultdict(dict), defaultdict(lambda: defaultdict(lambda: [0, 0, '']))
+    for line in open(path):
+        kind, rest = line.split(' ', 1)
+        f = rest.split()
+        at = float(f[0])
+        if kind == 'T':
+            t[at] = {k: int(v) for k, v in (x.split('=') for x in f[1:])}
+        elif kind == 'B':
+            b[at] = {k: int(v) for k, v in (x.split('=') for x in f[1:])}
+        elif kind == 'C':
+            c[at][f[1]] = {k: int(v) for k, v in (x.split('=') for x in f[2:])}
+        elif kind == 'S':
+            kv = dict(x.split('=') for x in f[3:])
+            s[at][f[1]] = [int(kv['n']), int(kv['cycles']), f[2]]
+    return t, b, c, s
+
+
+def window(path, lo, hi):
+    t, b, c, s = load(path)
+    times = sorted(t)
+    a = max(x for x in times if x <= lo + 1e-9)
+    z = min(x for x in times if x >= hi - 1e-9)
+    d = lambda x, y: {k: y[k] - x[k] for k in y}
+    T, B = d(t[a], t[z]), d(b[a], b[z])
+    C = {k: d(c[a][k], c[z][k]) for k in c[z]}
+    sites = defaultdict(lambda: [0, 0, ''])
+    for at in times:
+        if a < at <= z:
+            for addr, (n, cy, cl) in s[at].items():
+                sites[addr][0] += n; sites[addr][1] += cy; sites[addr][2] = cl
+    return a, z, T, B, C, sites
+
+
+def main():
+    path, lo, hi = sys.argv[1], float(sys.argv[2]), float(sys.argv[3])
+    a, z, T, B, C, sites = window(path, lo, hi)
+    cycles = T['cycles']
+    rtl = sum(B.values())
+    issued = B['issue_first'] + B['issue_more']
+    wrong = issued - T['commits']
+    out = {'from': a, 'to': z, 'cycles': cycles, 'cpu_clocks': rtl, 'retired': T['retired'],
+           'pm_retired': T['pm_retired'], 'commits': T['commits'], 'issued': issued, 'wrong_path_uops': wrong,
+           'redirects': T['redirects'], 'frames': T['frames'], 'polls_3da': T['polls_3da'],
+           'l1d_waits': T['l1d_waits'], 'l1i_waits': T['l1i_waits'], 'prefixes': T['prefixes'],
+           'buckets': B, 'classes': C}
+    print(f'window {a}..{z}: {cycles:,} clocks ({rtl:,} RTL clocks), {T["retired"]:,} retired, '
+          f'CPI {cycles / max(T["retired"], 1):.3f}, frames {T["frames"]}, '
+          f'{cycles / max(T["frames"], 1):,.0f} clocks/frame')
+    print(f'issued {issued:,} uops, committed {T["commits"]:,}, wrong path {wrong:,}; redirects {T["redirects"]:,}; '
+          f'uops/instr {T["commits"] / max(T["retired"], 1):.3f}')
+    groups = {
+        'useful issue': ['issue_first', 'issue_more'],
+        'redirect refill': ['refill', 'refill_l1i'],
+        'front end (L1I miss, empty)': ['fe_l1i', 'fe_empty'],
+        'L1D miss / port 0': ['frz_l1d'], 'MMIO (VGA)': ['frz_mmio'], 'I/O in WB': ['frz_io', 'parked_io'],
+        'INTA': ['frz_inta'], 'store buffer full': ['frz_store'], 'mul/div': ['frz_md'],
+        'AGI (load/late result to address)': ['agi'], 'segment write hazard': ['seg'], 'store-to-load': ['st_ld'],
+        'flags after shift': ['flag'], 'stack (ESP)': ['sp'], 'temp register (sequences)': ['temp'],
+        'microcode ROM read': ['urom'], 'string setup': ['str'], 'I/O serialise': ['io_serial'],
+        'halt': ['halt', 'parked_halt'], 'D stop': ['d_stop'], 'other': ['other_wait', 'gov', 'replay_serial', 'reset'],
+    }
+    print(f'{"bucket":40s} {"clocks":>14s} {"%":>6s} {"per instr":>9s}')
+    for name, keys in groups.items():
+        v = sum(B[k] for k in keys)
+        if name == 'useful issue':
+            v -= wrong
+        print(f'{name:40s} {v:14,d} {100 * v / rtl:6.2f} {v / max(T["retired"], 1):9.4f}')
+    print(f'{"wrong-path issue (flushed uops)":40s} {wrong:14,d} {100 * wrong / rtl:6.2f} {wrong / max(T["retired"], 1):9.4f}')
+    print(f'{"not on the RTL (Bochs)":40s} {cycles - rtl:14,d} {100 * (cycles - rtl) / cycles:6.2f}')
+    print(f'\n{"class":10s} {"n":>11s} {"taken":>11s} {"own":>13s} {"next":>13s} {"next/taken":>10s}')
+    for k, v in sorted(C.items(), key=lambda kv: -(kv[1]['own'] + kv[1]['next'])):
+        if v['n']:
+            print(f'{k:10s} {v["n"]:11,d} {v["taken"]:11,d} {v["own"]:13,d} {v["next"]:13,d} '
+                  f'{v["next"] / max(v["taken"], 1):10.2f}')
+    print('\ntop sites')
+    for addr, (n, cy, cl) in sorted(sites.items(), key=lambda kv: -kv[1][1])[:25]:
+        print(f'  {addr} {cl:9s} n={n:,} cycles={cy:,} ({100 * cy / cycles:.2f}%) {cy / n:.2f}/exec')
+    if '--json' in sys.argv:
+        json.dump(out, open(sys.argv[sys.argv.index('--json') + 1], 'w'), indent=1)
+
+
+main()
