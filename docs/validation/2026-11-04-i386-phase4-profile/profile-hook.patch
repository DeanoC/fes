--- a/sources/misteross/cores/fes-pc386/sim/cpu_profile_build.py	1970-01-01 02:00:00.000000000 +0200
+++ b/sources/misteross/cores/fes-pc386/sim/cpu_profile_build.py	2026-11-05 02:02:38.964749051 +0200
@@ -0,0 +1,22 @@
+#!/usr/bin/env python3
+"""Build the Phase 4 profile machine_tb (scratch): the worktree's RTL, this directory's patched testbench."""
+import argparse
+import sys
+from pathlib import Path
+
+root = Path(sys.argv[1]).resolve()
+here = Path(__file__).resolve().parent
+sys.path.insert(0, str(root))
+from scripts import sim_fes_pc386 as sim  # noqa: E402
+from scripts import fes_i386_oracle as oracle  # noqa: E402
+from scripts import build_pc386_firmware as firmware  # noqa: E402
+
+args = argparse.Namespace(verilator='verilator', jobs=12, download=True)
+linked = oracle.link_inputs(args.jobs, True)
+cpu = sim.verilate(args.verilator, 'p4prof', 'fes_i386_cpu', sim.CPU_RTL + (here / 'cpu_profile.vlt',), None, [], args.jobs)
+testbench = sim.verilate_with_audio(args, 'p4prof', here / 'machine_tb.cpp', [*linked, cpu],
+                                    top='pc386_machine', rtl=sim.MACHINE_RTL, include=(cpu.parent,))
+images = firmware.images(True, args.jobs)
+print(testbench)
+print(images['bios'])
+print(images['vgabios'])
diff -ruN a/sources/misteross/cores/fes-pc386/sim/cpu_profile_estimate.py b/sources/misteross/cores/fes-pc386/sim/cpu_profile_estimate.py
--- a/sources/misteross/cores/fes-pc386/sim/cpu_profile_estimate.py	1970-01-01 02:00:00.000000000 +0200
+++ b/sources/misteross/cores/fes-pc386/sim/cpu_profile_estimate.py	2026-11-05 02:02:38.964749051 +0200
@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+"""Phase 4 gain estimates from a window (analyse.py --json): estimate.py WIN.json [KIT_FPS]
+
+Kit clocks: each L1 miss is charged 7 fewer clocks than on the bench (port 0's
+18-clock first data at 100 MHz is 11 at 61.44 MHz). A correctly predicted taken
+branch leaves the target its average cost plus a one-clock bubble."""
+import json
+import sys
+
+w = json.load(open(sys.argv[1]))
+kit_fps = float(sys.argv[2]) if len(sys.argv) > 2 else None
+C, F, R = w['cycles'], max(w['frames'], 1), w['retired']
+cl, B = w['classes'], w['buckets']
+misses = w['l1d_waits'] + w['l1i_waits']
+kit = C - 7 * misses
+taken = sum(v['taken'] for v in cl.values())
+nexts = sum(v['next'] for v in cl.values())
+base = (C - nexts) / max(R - taken, 1)  # an instruction's average clocks when not after a taken branch
+pred = base + 1
+
+
+def br(names, lo, hi):
+    t = sum(cl[n]['taken'] for n in names if n in cl)
+    nx = sum(cl[n]['next'] for n in names if n in cl)
+    per = nx / max(t, 1) - pred
+    return t * per * lo, t * per * hi, t, nx / max(t, 1)
+
+
+rows = []
+jcc_nt = sum(cl[n]['n'] - cl[n]['taken'] for n in ('jcc', 'loop', 'jcxz'))
+lo, hi, t, per = br(['jcc', 'loop', 'jcxz'], 0.85, 0.95)
+false = jcc_nt * 0.05 * (per - 1)
+rows.append(('BTB: Jcc, LOOP, JCXZ', lo - false, hi - false, f'{t:,} taken at {per:.1f}'))
+lo, hi, t, per = br(['jmp', 'call'], 0.95, 0.99)
+rows.append(('BTB: JMP and CALL rel', lo, hi, f'{t:,} at {per:.1f}'))
+lo, hi, t, per = br(['ret'], 0.95, 0.99)
+rows.append(('Return stack: RET', lo, hi, f'{t:,} at {per:.1f}'))
+lo, hi, t, per = br(['call_ind', 'jmp_ind'], 0.7, 0.9)
+rows.append(('BTB: indirect JMP and CALL', lo, hi, f'{t:,} at {per:.1f}'))
+lo, hi, t, per = br(['far_call', 'far_jmp', 'retf'], 0.9, 0.98)
+rows.append(('Real-mode far prediction', lo, hi, f'{t:,} at {per:.1f} (all modes)'))
+rows.append(('Store-to-load wait', 0.5 * B['st_ld'], B['st_ld'], f'{B["st_ld"]:,} clocks'))
+rows.append(('Early ALU (AGI)', 0.3 * B['agi'], 0.8 * B['agi'], f'{B["agi"]:,} clocks, producers not split'))
+per_miss = B['frz_l1d'] / max(w['l1d_waits'], 1) - 7
+rows.append(('L2 (128 KiB)', w['l1d_waits'] * max(per_miss - 7, 0) * 0.5, w['l1d_waits'] * max(per_miss - 7, 0) * 0.8,
+             f'{w["l1d_waits"]:,} L1D misses at {per_miss:.0f} kit clocks'))
+rows.append(('Mul/div', 0.3 * B['frz_md'], 0.6 * B['frz_md'], f'{B["frz_md"]:,} clocks'))
+
+print(f'window {w["from"]}..{w["to"]}: bench {C:,} clocks, {F} frames, {C / F:,.0f}/frame; '
+      f'kit-equivalent {kit / F:,.0f}/frame -> {61.44e6 / (kit / F):.2f} fps at 61.44 MHz; base {base:.2f}')
+print(f'{"feature":30s} {"% of kit clocks":>17s} {"fps":>13s}  basis')
+total_lo = total_hi = 0
+for name, lo, hi, basis in rows:
+    total_lo += lo
+    total_hi += hi
+    ref = kit_fps or 61.44e6 / (kit / F)
+    f = lambda s: ref * kit / (kit - s)
+    print(f'{name:30s} {100 * lo / kit:7.1f}-{100 * hi / kit:5.1f}%  {f(lo):5.1f}-{f(hi):5.1f}  {basis}')
+pl = sum(r[1] for r in rows[:5]); ph = sum(r[2] for r in rows[:5])
+ref = kit_fps or 61.44e6 / (kit / F)
+print(f'{"prediction (first five)":30s} {100 * pl / kit:7.1f}-{100 * ph / kit:5.1f}%  '
+      f'{ref * kit / (kit - pl):5.1f}-{ref * kit / (kit - ph):5.1f}')
diff -ruN a/sources/misteross/cores/fes-pc386/sim/cpu_profile.h b/sources/misteross/cores/fes-pc386/sim/cpu_profile.h
--- a/sources/misteross/cores/fes-pc386/sim/cpu_profile.h	1970-01-01 02:00:00.000000000 +0200
+++ b/sources/misteross/cores/fes-pc386/sim/cpu_profile.h	2026-11-05 02:02:38.960748886 +0200
@@ -0,0 +1,217 @@
+// SPDX-License-Identifier: MIT
+// Phase 4 profile hook for machine_tb --cpu rtl (scratch, bench only; not committed).
+// Reads D's issue and wait terms through cpu_profile.vlt's public_flat_rd signals and
+// classifies every system clock, and attributes each retirement's clocks to its class.
+#pragma once
+
+#include "Vfes_i386_cpu.h"
+#include "Vfes_i386_cpu___024root.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+struct CpuProfile {
+    enum Bucket {
+        ISSUE_FIRST, ISSUE_MORE, HALT, FRZ_L1D, FRZ_MMIO, FRZ_MD, FRZ_IO, FRZ_INTA, FRZ_STORE,
+        REFILL, REFILL_L1I, FE_L1I, FE_EMPTY, D_STOP, GOV, AGI, SEG, STLD, FLAG, SP, TEMP, UROM, STR,
+        IO_SERIAL, REPLAY_SERIAL, OTHER_WAIT, PARKED_IO, PARKED_HALT, RESET, NBUCKET
+    };
+    static constexpr const char *bucket_name[NBUCKET] = {
+        "issue_first", "issue_more", "halt", "frz_l1d", "frz_mmio", "frz_md", "frz_io", "frz_inta", "frz_store",
+        "refill", "refill_l1i", "fe_l1i", "fe_empty", "d_stop", "gov", "agi", "seg", "st_ld", "flag", "sp",
+        "temp", "urom", "str", "io_serial", "replay_serial", "other_wait", "parked_io", "parked_halt", "reset"};
+    enum Class {
+        C_JCC, C_JMP, C_JMP_IND, C_CALL, C_CALL_IND, C_RET, C_FAR_CALL, C_FAR_JMP, C_RETF, C_INT, C_IRET,
+        C_LOOP, C_JCXZ, C_REP_STR, C_STR, C_IO, C_MUL, C_DIV, C_SHIFT, C_PUSHPOP, C_SEGLOAD, C_LOAD_OP, C_OTHER,
+        C_DELIVERY, NCLASS
+    };
+    static constexpr const char *class_name[NCLASS] = {
+        "jcc", "jmp", "jmp_ind", "call", "call_ind", "ret", "far_call", "far_jmp", "retf", "int", "iret",
+        "loop", "jcxz", "rep_str", "str", "io", "mul", "div", "shift", "pushpop", "segload", "mem_op", "other",
+        "delivery"};
+    struct Counts { uint64_t n = 0, taken = 0, own = 0, next = 0, next_taken_l1i = 0; };
+
+    uint64_t bucket[NBUCKET] = {};
+    uint64_t commits = 0, flushes = 0, redirects = 0, l1d_waits = 0, l1i_waits = 0, retired = 0, pm_retired = 0;
+    uint64_t frames = 0, polls_3da = 0, io_accesses = 0;
+    Counts cls[NCLASS];
+    uint64_t prefixes = 0;  // prefix bytes before the last one, which cost a cycle each
+    struct Site { uint64_t n = 0, cycles = 0; uint8_t c = 0; };
+    std::unordered_map<uint32_t, Site> sites;  // per dump interval, by linear start
+    uint64_t last_retire = 0;
+    int pending = -1;  // the class of a taken instruction whose target has not retired
+    bool since_redirect = false, was_l1d = false, was_l1i = false, refill_l1i = false;
+    uint64_t sampled = 0;  // clocks classified (sample + parked)
+
+    template <typename Cpu> void sample(Cpu &cpu, bool mmio_busy, bool resetting) {
+        ++sampled;
+        auto *r = cpu.rootp;
+#define S(name) (r->fes_i386_cpu__DOT__##name)
+        if (resetting) { ++bucket[RESET]; return; }
+        const bool redirect = S(redirect);
+        if (S(wb_commit)) ++commits;
+        if (S(wb_flush)) ++flushes;
+        const bool l1d = S(freeze) && S(m2_load) && !S(dmem_valid) && !mmio_busy;
+        if (l1d && !was_l1d) ++l1d_waits;
+        was_l1d = l1d;
+        const bool l1i = !S(mem_valid);
+        if (l1i && !was_l1i) ++l1i_waits;
+        was_l1i = l1i;
+        Bucket b;
+        if (S(issue)) {
+            b = S(d_first) ? ISSUE_FIRST : ISSUE_MORE;
+            since_redirect = false;
+        } else if (S(halted)) b = HALT;
+        else if (S(freeze)) {
+            if (S(m2_load) && !S(dmem_valid)) b = mmio_busy ? FRZ_MMIO : FRZ_L1D;
+            else if (S(md_busy)) b = FRZ_MD;
+            else if (S(io_wait)) b = FRZ_IO;
+            else if (S(int_wait)) b = FRZ_INTA;
+            else b = FRZ_STORE;
+        } else if (!S(dc_valid)) {
+            if (since_redirect) b = l1i || refill_l1i ? REFILL_L1I : REFILL;
+            else b = l1i ? FE_L1I : FE_EMPTY;
+            if (since_redirect && l1i) refill_l1i = true;
+        } else if (S(d_stop)) b = D_STOP;
+        else if (S(gov_block)) b = GOV;
+        else if (S(addr_use) && S(lea_stall)) b = AGI;
+        else if (S(reads_seg) && S(seg_hazard) || S(mem) && S(mseg_hazard)) b = SEG;
+        else if (S(store_hazard)) b = STLD;
+        else if (S(flag_hazard)) b = FLAG;
+        else if (S(sp_hazard) || S(stack_wait)) b = SP;
+        else if (S(t_wait)) b = TEMP;
+        else if (S(uc_wait)) b = UROM;
+        else if (S(str_wait) || S(str_hazard)) b = STR;
+        else if (S(io_hazard)) b = IO_SERIAL;
+        else if (S(ser_wait)) b = REPLAY_SERIAL;
+        else b = OTHER_WAIT;
+        ++bucket[b];
+        if (redirect) { ++redirects; since_redirect = true; refill_l1i = false; }
+#undef S
+    }
+    void parked(bool asleep) { ++sampled; ++bucket[asleep ? PARKED_HALT : PARKED_IO]; }
+    void io(bool write, uint16_t port, uint32_t wdata) {
+        ++io_accesses;
+        if (write && port == 0x3d4 && (wdata & 0xff) == 0x0c) ++frames;
+        if (!write && port == 0x3da) ++polls_3da;
+    }
+
+    static Class classify(const uint8_t *b, unsigned length, unsigned &extra_prefixes) {
+        unsigned at = 0;
+        bool rep = false;
+        for (; at < length; ++at) {
+            const uint8_t p = b[at];
+            if (p == 0xf2 || p == 0xf3) rep = true;
+            else if (!(p == 0x66 || p == 0x67 || p == 0xf0 || p == 0x26 || p == 0x2e || p == 0x36 || p == 0x3e
+                       || p == 0x64 || p == 0x65)) break;
+        }
+        extra_prefixes = at > 1 ? at - 1 : 0;
+        if (at >= length) return C_OTHER;
+        const uint8_t op = b[at];
+        const uint8_t reg = at + 1 < length ? (b[at + 1] >> 3) & 7 : 0;
+        const bool rm_mem = at + 1 < length && (b[at + 1] >> 6) != 3;
+        if (op == 0x0f) {
+            const uint8_t op2 = at + 1 < length ? b[at + 1] : 0;
+            if (op2 >= 0x80 && op2 <= 0x8f) return C_JCC;
+            if (op2 == 0xaf) return C_MUL;
+            if (op2 == 0xa4 || op2 == 0xa5 || op2 == 0xac || op2 == 0xad) return C_SHIFT;
+            if (op2 == 0xa0 || op2 == 0xa1 || op2 == 0xa8 || op2 == 0xa9) return C_PUSHPOP;
+            if (op2 == 0xb2 || op2 == 0xb4 || op2 == 0xb5) return C_SEGLOAD;
+            return C_OTHER;
+        }
+        if (op >= 0x70 && op <= 0x7f) return C_JCC;
+        if (op == 0xeb || op == 0xe9) return C_JMP;
+        if (op == 0xe8) return C_CALL;
+        if (op == 0xc3 || op == 0xc2) return C_RET;
+        if (op == 0x9a) return C_FAR_CALL;
+        if (op == 0xea) return C_FAR_JMP;
+        if (op == 0xca || op == 0xcb) return C_RETF;
+        if (op == 0xcc || op == 0xcd || op == 0xce) return C_INT;
+        if (op == 0xcf) return C_IRET;
+        if (op >= 0xe0 && op <= 0xe2) return C_LOOP;
+        if (op == 0xe3) return C_JCXZ;
+        if (op == 0xff) {
+            if (reg == 2) return C_CALL_IND;
+            if (reg == 3) return C_FAR_CALL;
+            if (reg == 4) return C_JMP_IND;
+            if (reg == 5) return C_FAR_JMP;
+            if (reg == 6) return C_PUSHPOP;
+        }
+        if ((op >= 0xa4 && op <= 0xa7) || (op >= 0xaa && op <= 0xaf) || (op >= 0x6c && op <= 0x6f))
+            return rep ? C_REP_STR : C_STR;
+        if ((op >= 0xe4 && op <= 0xe7) || (op >= 0xec && op <= 0xef)) return C_IO;
+        if (op == 0xf6 || op == 0xf7) {
+            if (reg == 4 || reg == 5) return C_MUL;
+            if (reg == 6 || reg == 7) return C_DIV;
+        }
+        if (op == 0x69 || op == 0x6b) return C_MUL;
+        if (op == 0xc0 || op == 0xc1 || (op >= 0xd0 && op <= 0xd3)) return C_SHIFT;
+        if ((op >= 0x50 && op <= 0x61) || op == 0x68 || op == 0x6a || op == 0x8f || op == 0x9c || op == 0x9d
+            || op == 0x06 || op == 0x07 || op == 0x0e || op == 0x16 || op == 0x17 || op == 0x1e || op == 0x1f
+            || op == 0xc8 || op == 0xc9)
+            return C_PUSHPOP;
+        if (op == 0x8e || op == 0xc4 || op == 0xc5) return C_SEGLOAD;
+        // A ModRM memory operand among the ALU, MOV and test forms.
+        const bool modrm = op < 0x40 ? (op & 7) < 4 : (op >= 0x80 && op <= 0x8b) || op == 0x8d || op == 0xc6 || op == 0xc7
+                           || op == 0xfe || op == 0xff || op == 0xf6 || op == 0xf7;
+        if (modrm && rm_mem && op != 0x8d) return C_LOAD_OP;
+        if (op >= 0xa0 && op <= 0xa3) return C_LOAD_OP;
+        return C_OTHER;
+    }
+
+    // A retirement at clock now: the instruction at start, the next at next.
+    void retire(uint64_t now, uint32_t start, uint32_t next, const uint8_t *bytes, unsigned length, bool delivery,
+                bool pe) {
+        ++retired;
+        if (pe) ++pm_retired;
+        const uint64_t gap = now - last_retire;
+        last_retire = now;
+        unsigned extra = 0;
+        const Class c = delivery ? C_DELIVERY : classify(bytes, length, extra);
+        prefixes += extra;
+        Counts &k = cls[c];
+        ++k.n;
+        k.own += gap;
+        if (pending >= 0) {
+            cls[pending].next += gap;
+            pending = -1;
+        }
+        if (delivery || next != start + length) {
+            ++k.taken;
+            pending = c;
+        }
+        Site &s = sites[start];
+        ++s.n;
+        s.cycles += gap;
+        s.c = uint8_t(c);
+    }
+
+    void dump(FILE *out, uint64_t cycles, double seconds) {
+        std::fprintf(out, "T %.3f cycles=%llu sampled=%llu retired=%llu pm_retired=%llu commits=%llu flushes=%llu "
+                     "redirects=%llu l1d_waits=%llu l1i_waits=%llu frames=%llu polls_3da=%llu io=%llu prefixes=%llu\n",
+                     seconds, (unsigned long long)cycles, (unsigned long long)sampled, (unsigned long long)retired,
+                     (unsigned long long)pm_retired, (unsigned long long)commits, (unsigned long long)flushes,
+                     (unsigned long long)redirects, (unsigned long long)l1d_waits, (unsigned long long)l1i_waits,
+                     (unsigned long long)frames, (unsigned long long)polls_3da, (unsigned long long)io_accesses,
+                     (unsigned long long)prefixes);
+        std::fprintf(out, "B %.3f", seconds);
+        for (int b = 0; b < NBUCKET; ++b) std::fprintf(out, " %s=%llu", bucket_name[b], (unsigned long long)bucket[b]);
+        std::fprintf(out, "\n");
+        for (int c = 0; c < NCLASS; ++c)
+            std::fprintf(out, "C %.3f %s n=%llu taken=%llu own=%llu next=%llu\n", seconds, class_name[c],
+                         (unsigned long long)cls[c].n, (unsigned long long)cls[c].taken,
+                         (unsigned long long)cls[c].own, (unsigned long long)cls[c].next);
+        std::vector<std::pair<uint32_t, Site>> top(sites.begin(), sites.end());
+        std::sort(top.begin(), top.end(), [](const auto &a, const auto &b) { return a.second.cycles > b.second.cycles; });
+        if (top.size() > 120) top.resize(120);
+        for (const auto &[at, s] : top)
+            std::fprintf(out, "S %.3f %08x %s n=%llu cycles=%llu\n", seconds, at, class_name[s.c],
+                         (unsigned long long)s.n, (unsigned long long)s.cycles);
+        sites.clear();  // site lines are per interval
+        std::fflush(out);
+    }
+};
