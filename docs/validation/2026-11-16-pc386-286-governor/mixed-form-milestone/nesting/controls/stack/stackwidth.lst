    18 0000001B 8ED8                        mov ds,ax
    19 0000001D 8EC0                        mov es,ax
    20 0000001F 8ED0                        mov ss,ax
    21 00000021 66BC00800100                mov esp,0x00018000
    22                                  
    23                                  ; The taken branch and NOPs put each marked window behind the same queue
    24                                  ; flush. The SS write is immediately followed by the instruction under test.
    25                                  %macro PREP 3
    26                                      mov ax,%1              ; initial SS selector
    27                                      mov ss,ax
    28                                      mov esp,0x00018000
    29                                      mov ebp,%3
    30                                      mov word [0x7ffe],0x1357
    31                                      mov word [dword 0x17ffe],0x2468
    32                                      mov si,%2              ; destination SS selector
    33                                      jmp %%clean
    34                                  %%clean:
    35                                      nop
    36                                      nop
    37                                      nop
    38                                      nop
    39                                  %endmacro
    40                                  %macro MARK 1
    41                                      mov al,%1
    42                                      out 0x80,al
    43                                  %endmacro
    44                                  %macro ENTER_CASE 4
    45                                      PREP %1,%2,0x00013456
    46                                      MARK %3
    47                                      mov ss,si
    48                                      enter 0x20,0
    49                                      MARK %4
    50                                      cmp esp,0x00017fde
    51                                      jne fail
    52                                      cmp ebp,0x00017ffe
    53                                      jne fail
    54                                      %if %2 == 0x10
    55                                          cmp word [0x7ffe],0x3456
    56                                          jne fail
    57                                          cmp word [dword 0x17ffe],0x2468
    58                                          jne fail
    59                                      %else
    60                                          cmp word [dword 0x17ffe],0x3456
    61                                          jne fail
    62                                          cmp word [0x7ffe],0x1357
    63                                          jne fail
    64                                      %endif
    65                                  %endmacro
    66                                  %macro LEAVE_CASE 4
    67                                      PREP %1,%2,0x00017ffe
    68                                      MARK %3
    69                                      mov ss,si
    70                                      leave
    71                                      MARK %4
    72                                      cmp esp,0x00018000
    73                                      jne fail
    74                                      %if %2 == 0x10
    75                                          cmp ebp,0x00011357
    76                                      %else
    77                                          cmp ebp,0x00012468
    78                                      %endif
    79                                      jne fail
    80                                      cmp word [0x7ffe],0x1357
    81                                      jne fail
    82                                      cmp word [dword 0x17ffe],0x2468
    83                                      jne fail
    84                                  %endmacro
    85                                  
