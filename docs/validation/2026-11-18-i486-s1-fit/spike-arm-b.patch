+                n.more = d.step != 3'd2;
+                n.uop.ctl.end_of_instruction = d.step == 3'd2;
+            end
             fes_i386_pkg::SEQ_CALLI: begin
                 // The push of the next EIP, then (its address and sizes
                 // kept) the jump to T1.
