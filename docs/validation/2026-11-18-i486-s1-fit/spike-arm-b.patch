+            // ---- The i486 identity's sequences (#1962 slice 1 fit spike) ----
+            fes_i386_pkg::SEQ_XADD: begin
+                // The first uop is XCHG's first XOR (r/m ^= r); then r ^= r/m,
+                // r/m ^= r, and r/m += r with its flags.
+                n.uop.cls = fes_i386_pkg::UOP_ALU;
+                n.uop.flags = '0;
