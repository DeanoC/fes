+                    n.uop.src2 = d0.uop.src2;
+                    n.uop.dst = d0.uop.src1;
+                    n.uop.ctl.cond = 4'b0101;  // NZ
+                    n.uop.ctl.end_of_instruction = 1'b1;
+                end
+            end
+            fes_i386_pkg::SEQ_CMPXM: begin
+                // After r/m into T1 (the first uop, r in src1): CMP eAX, T1;
