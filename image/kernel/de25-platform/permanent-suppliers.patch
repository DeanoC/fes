+
+	/* Same lock order as ordinary attachment: group, then ASID. */
+	if (!mutex_trylock(&arm_smmu_asid_lock))
+		return -EBUSY;
+	entry = arm_smmu_get_step_for_sid(master->smmu, 10);
+	ret = arm_smmu_de25_block_ste_checked(master, 10, entry);
+	mutex_unlock(&arm_smmu_asid_lock);
+	return ret;
+}
+
+int fes_de25_sdm_block_dma(struct device *dev)
+{
+	struct arm_smmu_de25_block_context context = { .dev = dev };
+	struct iommu_group *group;
+	int ret;
+
+	if (!dev || dev_is_pci(dev) ||
+	    !of_device_is_compatible(dev->of_node, "intel,agilex5-svc"))
+		return -ENODEV;
+	group = iommu_group_get(dev);
+	if (!group)
+		return -ENODEV;
+	ret = iommu_group_for_each_dev(group, &context,
+				      arm_smmu_de25_block_group_device);
+	iommu_group_put(group);
+	if (!ret && !context.found)
+		return -ENODEV;
+	return ret;
+}
+EXPORT_SYMBOL_GPL(fes_de25_sdm_block_dma);
+#endif
