+/* The DE25 profile uses the DMA API's IOVA allocator and coherent CPU mapping.
+ * Keep paddr as the vendor driver's raw IOVA lookup key: submit adds the
+ * existing ATF offset and completion returns the raw IOVA.
+ */
+static int svc_alloc_coherent_memory(struct stratix10_svc_controller *ctrl,
+		struct stratix10_svc_data_mem *pmem, size_t size)
+{
+	const dma_addr_t limit = DMA_BIT_MASK(29);
+	dma_addr_t addr;
+	void *va;
+
+	if (!size || size > limit + 1)
+		return -EINVAL;
+	size = PAGE_ALIGN(size);
+	va = dma_alloc_coherent(ctrl->dev, size, &addr, GFP_KERNEL);
+	if (!va)
+		return -ENOMEM;
+	if (addr > limit || size - 1 > limit - addr) {
+		dma_free_coherent(ctrl->dev, size, va, addr);
+		return -ERANGE;
+	}
+	pmem->vaddr = va;
+	pmem->paddr = addr;
+	pmem->dma_addr = addr;
+	pmem->size = size;
+	return 0;
+}
