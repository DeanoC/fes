+/* Containment never takes sdm_lock, joins a worker or releases DMA storage. */
+int stratix10_svc_block_dma(struct stratix10_svc_chan *chan)
+{
+	struct stratix10_svc_controller *ctrl;
+	unsigned long flags;
+	int ret;
+
+	if (!IS_ENABLED(CONFIG_FES_DE25_SDM_CONTAINMENT))
+		return -EOPNOTSUPP;
+	if (!chan || !chan->ctrl || !chan->name ||
+	    strcmp(chan->name, SVC_CLIENT_FPGA))
+		return -EINVAL;
+	ctrl = chan->ctrl;
+	if (!ctrl->is_smmu_enabled || !ctrl->use_dma_mem)
+		return -EOPNOTSUPP;
+
+	spin_lock_irqsave(&ctrl->de25_admission_lock, flags);
+	if (ctrl->de25_block_started) {
+		ret = ctrl->de25_block_status;
+		spin_unlock_irqrestore(&ctrl->de25_admission_lock, flags);
+		return ret;
+	}
+	if (ctrl->num_active_client != 1 || !chan->scl) {
+		spin_unlock_irqrestore(&ctrl->de25_admission_lock, flags);
+		return -EBUSY;
+	}
+	/* Admission and ownership stay closed for the rest of this kernel epoch. */
+	ctrl->de25_block_started = true;
+	ctrl->de25_block_status = -EINPROGRESS;
+	spin_unlock_irqrestore(&ctrl->de25_admission_lock, flags);
+
+	ret = fes_de25_sdm_block_dma(ctrl->dev);
+	spin_lock_irqsave(&ctrl->de25_admission_lock, flags);
+	ctrl->de25_block_status = ret;
+	spin_unlock_irqrestore(&ctrl->de25_admission_lock, flags);
+	return ret;
+}
