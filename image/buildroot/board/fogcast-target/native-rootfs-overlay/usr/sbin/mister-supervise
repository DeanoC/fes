#!/bin/sh
set -eu

[ "$#" -ge 2 ] || {
  printf 'usage: mister-supervise NAME COMMAND [ARG...]\n' >&2
  exit 2
}

name=$1
shift
case "$name" in
  *[!a-zA-Z0-9_-]*|'')
    printf '%s\n' 'mister-supervise: invalid service name' >&2
    exit 2
    ;;
esac

pid_file=/run/$name.pid
log_file=/var/log/$name.log
child=

log_event() {
  # Supervision must keep running if the log directory is removed while a
  # stop or restart is still writing (test cleanup, or a late escalator).
  [ -d "${log_file%/*}" ] || return 0
  event_time=$(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ')
  printf '%s %s\n' "$event_time" "$1" >> "$log_file" 2>/dev/null || return 0
}

terminate() {
  trap - INT TERM
  if [ -n "$child" ] && /bin/kill -0 "$child" 2>/dev/null; then
    /bin/kill "$child" 2>/dev/null || true
    # Bounded stop (#429): wait reaps a child that exits promptly. An escalator
    # KILLs it after 5 s; if it still has not been reaped 2 s later (stuck in
    # D state), the escalator logs, removes the pid file and KILLs this
    # supervisor so shutdown is never held by an unbounded wait.
    supervisor=$$
    (
      /bin/sleep 5
      /bin/kill -0 "$child" 2>/dev/null || exit 0
      log_event "killing child=$child after TERM timeout"
      /bin/kill -KILL "$child" 2>/dev/null || exit 0
      /bin/sleep 2
      if /bin/kill -0 "$child" 2>/dev/null; then
        /bin/rm -f "$pid_file"
        log_event "stopped child=$child unkillable"
        /bin/kill -KILL "$supervisor" 2>/dev/null || true
      fi
    ) &
    escalator=$!
    wait "$child" 2>/dev/null || true
    # Stop the escalator shell and wait until it is gone before touching
    # its sleep child. Killing that sleep while the shell is alive wakes
    # the shell, which would log or signal after the child pid is stale.
    # Once the shell is dead, the orphaned sleep cannot resume the script.
    kids=
    if [ -r "/proc/$escalator/task/$escalator/children" ]; then
      kids=$(cat "/proc/$escalator/task/$escalator/children" 2>/dev/null || true)
    fi
    /bin/kill "$escalator" 2>/dev/null || true
    wait "$escalator" 2>/dev/null || true
    if [ -n "$kids" ]; then
      /bin/kill $kids 2>/dev/null || true
    fi
  fi
  /bin/rm -f "$pid_file"
  log_event stopped
  exit 0
}

trap terminate INT TERM
while :; do
  log_event starting
  "$@" >> "$log_file" 2>&1 &
  child=$!
  printf '%s\n' "$child" > "$pid_file"
  status=0
  wait "$child" || status=$?
  /bin/rm -f "$pid_file"
  child=
  log_event "exited status=$status"
  /bin/sleep 1
done
