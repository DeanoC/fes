#!/bin/sh
set -eu

supervisor_pid=/run/mister-runtime-supervisor.pid
child_pid=/run/mister-runtime.pid

read_pid() {
  [ -f "$1" ] || return 1
  IFS= read -r pid < "$1"
  case "$pid" in ''|*[!0-9]*|0|1) return 1 ;; esac
}

stop_service() {
  [ -f "$supervisor_pid" ] || return 0
  read_pid "$supervisor_pid" || { /bin/rm -f "$supervisor_pid" "$child_pid"; return 0; }
  supervisor=$pid
  /bin/kill "$supervisor" 2>/dev/null || true
  stop_wait=5
  while /bin/kill -0 "$supervisor" 2>/dev/null && [ "$stop_wait" -gt 0 ]; do
    /bin/sleep 1
    stop_wait=$((stop_wait - 1))
  done
  if /bin/kill -0 "$supervisor" 2>/dev/null; then
    if read_pid "$child_pid"; then
      /bin/kill -KILL "$pid" 2>/dev/null || true
    fi
    /bin/kill -KILL "$supervisor" 2>/dev/null || true
  fi
  /bin/rm -f "$supervisor_pid" "$child_pid"
}

case "${1:-start}" in
  start)
    set --
    menu_selection=/usr/share/mister-runtime/selections/fes-menu.package.toml
    if [ -f "$menu_selection" ] && [ ! -L "$menu_selection" ]; then
      menu_id=$(awk -F= '/^[[:space:]]*package_id[[:space:]]*=/ {
        value=$2; gsub(/[[:space:]\047\042]/, "", value); print value; exit
      }' "$menu_selection")
      case "$menu_id" in
        *[!0-9a-f]*|'') echo 'mister-runtime: invalid menu selection' >&2; exit 1 ;;
      esac
      [ "${#menu_id}" -eq 64 ] || { echo 'mister-runtime: invalid menu ID' >&2; exit 1; }
      menu_package=/usr/share/mister-runtime/core-packages/$menu_id
      [ -d "$menu_package" ] && [ ! -L "$menu_package" ] || {
        echo 'mister-runtime: selected menu package is missing' >&2; exit 1;
      }
      set -- --menu-package "$menu_package" "$menu_id"
    fi
    /usr/sbin/mister-supervise mister-runtime /usr/sbin/mister-runtime "$@" &
    printf '%s\n' "$!" > /run/mister-runtime-supervisor.pid
    ;;
  stop)
    stop_service
    ;;
  restart)
    stop_service
    "$0" start
    ;;
  *)
    printf 'usage: %s start|stop|restart\n' "$0" >&2
    exit 2
    ;;
esac
