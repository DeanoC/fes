#!/bin/sh
set -eu

pid_file=/run/udhcpc.pid

stop_service() {
  [ -f "$pid_file" ] || return 0
  IFS= read -r pid < "$pid_file"
  if /bin/kill -0 "$pid" 2>/dev/null; then
    /bin/kill "$pid"
    stop_wait=5
    while /bin/kill -0 "$pid" 2>/dev/null && [ "$stop_wait" -gt 0 ]; do
      /bin/sleep 1
      stop_wait=$((stop_wait - 1))
    done
  fi
  /bin/rm -f "$pid_file"
}

case "${1:-start}" in
  start)
    /sbin/ip link set lo up
    wait_seconds=10
    while [ ! -e /sys/class/net/eth0 ] && [ "$wait_seconds" -gt 0 ]; do
      /bin/sleep 1
      wait_seconds=$((wait_seconds - 1))
    done
    if [ ! -e /sys/class/net/eth0 ]; then
      printf '%s\n' 'mister-network: eth0 did not appear within 10 seconds' >&2
      exit 1
    fi
    /sbin/ip link set eth0 up
    # Keep the foreground client supervised after the first lease so it renews
    # that lease and retries if the PHY/switch is still settling at startup.
    hostname=$(/bin/hostname)
    /sbin/udhcpc -f -p "$pid_file" -t 5 -T 2 -i eth0 -x "hostname:$hostname" -s /usr/share/udhcpc/default.script &
    printf '%s\n' "$!" > "$pid_file"
    ;;
  stop)
    stop_service
    ;;
  restart)
    stop_service
    "$0" start
    ;;
  *)
    printf 'usage: %s start|stop|restart\n' "$0" >&2
    exit 2
    ;;
esac
