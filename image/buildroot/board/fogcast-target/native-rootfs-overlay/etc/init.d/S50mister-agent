#!/bin/sh
set -eu

supervisor_pid=/run/mister-agent-supervisor.pid
child_pid=/run/mister-agent.pid

read_pid() {
  [ -f "$1" ] || return 1
  IFS= read -r pid < "$1"
  case "$pid" in ''|*[!0-9]*|0|1) return 1 ;; esac
}

stop_service() {
  [ -f "$supervisor_pid" ] || return 0
  read_pid "$supervisor_pid" || { /bin/rm -f "$supervisor_pid" "$child_pid"; return 0; }
  supervisor=$pid
  /bin/kill "$supervisor" 2>/dev/null || true
  stop_wait=5
  while /bin/kill -0 "$supervisor" 2>/dev/null && [ "$stop_wait" -gt 0 ]; do
    /bin/sleep 1
    stop_wait=$((stop_wait - 1))
  done
  if /bin/kill -0 "$supervisor" 2>/dev/null; then
    if read_pid "$child_pid"; then
      /bin/kill -KILL "$pid" 2>/dev/null || true
    fi
    /bin/kill -KILL "$supervisor" 2>/dev/null || true
  fi
  /bin/rm -f "$supervisor_pid" "$child_pid"
}

case "${1:-start}" in
  start)
    wait_seconds=30
    while [ ! -f /media/fat/fogcast/agent.toml ] && [ "$wait_seconds" -gt 0 ]; do
      /bin/sleep 1
      wait_seconds=$((wait_seconds - 1))
    done
    if [ ! -f /media/fat/fogcast/agent.toml ]; then
      printf '%s\n' 'mister-agent: writable FAT configuration did not appear within 30 seconds' >&2
      exit 1
    fi
    /bin/mkdir -p /media/fat/fogcast/cache
    /bin/chmod 0700 /media/fat/fogcast/cache

    /usr/sbin/mister-supervise mister-agent /usr/sbin/mister-agent \
      --config /media/fat/fogcast/agent.toml &
    printf '%s\n' "$!" > /run/mister-agent-supervisor.pid
    ;;
  stop)
    stop_service
    ;;
  restart)
    stop_service
    "$0" start
    ;;
  *)
    printf 'usage: %s start|stop|restart\n' "$0" >&2
    exit 2
    ;;
esac
