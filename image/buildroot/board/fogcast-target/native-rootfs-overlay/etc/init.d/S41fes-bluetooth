#!/bin/sh
# Pair HID and HoG controllers once bluetoothd is up. Link keys stay on the
# FAT state directory across reboots. Hold the controller's pair button.
set -eu

pid_file=/run/fes-bluetooth.pid
log=/var/log/fes-bluetooth.log

stop_agent() {
  # No stop countdown: the shutdown budget is already full, and the agent
  # returns as soon as it receives SIGTERM.
  [ -f "$pid_file" ] || return 0
  IFS= read -r pid < "$pid_file" || true
  if [ -n "${pid:-}" ] && /bin/kill -0 "$pid" 2>/dev/null; then
    /bin/kill "$pid" 2>/dev/null || true
  fi
  /bin/rm -f "$pid_file"
}

restart_agent() {
  if [ -f "$pid_file" ]; then
    IFS= read -r pid < "$pid_file" || true
    if [ -n "${pid:-}" ] && /bin/kill -0 "$pid" 2>/dev/null; then
      /bin/kill "$pid" 2>/dev/null || true
      restart_wait=5
      while /bin/kill -0 "$pid" 2>/dev/null && [ "$restart_wait" -gt 0 ]; do
        /bin/sleep 1
        restart_wait=$((restart_wait - 1))
      done
      if /bin/kill -0 "$pid" 2>/dev/null; then
        printf '%s\n' "fes-bluetooth: PID $pid did not exit; restart cancelled" >&2
        return 1
      fi
    fi
    /bin/rm -f "$pid_file"
  fi
  "$0" start
}

case "${1:-start}" in
  start)
    if [ -f "$pid_file" ]; then
      IFS= read -r pid < "$pid_file"
      if /bin/kill -0 "$pid" 2>/dev/null; then
        exit 0
      fi
    fi
    /usr/sbin/fes-bluetooth >>"$log" 2>&1 &
    printf '%s\n' "$!" > "$pid_file"
    ;;
  stop)
    stop_agent
    ;;
  restart)
    restart_agent
    ;;
  *)
    printf '%s\n' "usage: $0 start|stop|restart" >&2
    exit 2
    ;;
esac
