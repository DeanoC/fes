#!/bin/sh
# Run before mdev. usb-storage is built in, so this only updates the quirks
# parameter for a probe that has not started yet. The boot command line is
# installed with the disk image and is not rewritten here.
# FES_USB_QUIRK overrides the helper in tests.
set -u
case "${1:-start}" in
start)
  quirk=${FES_USB_QUIRK:-/usr/sbin/fes-usb-quirk}
  "$quirk" || :
  ;;
stop)
  ;;
*)
  printf '%s\n' "usage: $0 start|stop" >&2
  exit 2
  ;;
esac
