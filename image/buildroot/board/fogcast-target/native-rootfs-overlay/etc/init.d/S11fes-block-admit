#!/bin/sh
# Run after mdev has created nodes for disks that are already attached.
# Hotplug of a later dock DVD or USB stick is handled by /etc/mdev.conf.
# Buildroot's S10mdev points the kernel hotplug helper at mdev; repeat that
# here so the sd/sr rules still run if a device appears after this script.
# FES_BLOCK_ADMIT overrides the helper path in tests.
# FES_HOTPLUG overrides the hotplug file in tests.
set -eu
case "${1:-start}" in
start)
  hotplug=${FES_HOTPLUG:-/proc/sys/kernel/hotplug}
  if [ -n "${FES_HOTPLUG:-}" ] || [ -w /proc/sys/kernel/hotplug ]; then
    printf '%s\n' /sbin/mdev > "$hotplug" 2>/dev/null || :
  fi
  admit=${FES_BLOCK_ADMIT:-/usr/sbin/fes-block-admit}
  "$admit"
  ;;
stop)
  ;;
*)
  printf '%s\n' "usage: $0 start|stop" >&2
  exit 2
  ;;
esac
