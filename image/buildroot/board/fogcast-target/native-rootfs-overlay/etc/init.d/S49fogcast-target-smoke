#!/bin/sh
set -eu

case "${1:-start}" in
  start) : ;;
  stop) exit 0 ;;
  *)
    printf 'usage: %s start|stop\n' "$0" >&2
    exit 2
    ;;
esac

IFS= read -r cmdline < /proc/cmdline
case " $cmdline " in
  *' fogcast_target_smoke=1 '*) : ;;
  *) exit 0 ;;
esac

root_options=$(/usr/bin/awk '$2 == "/" { print $4; exit }' /proc/mounts)
case ",$root_options," in
  *,ro,*) : ;;
  *)
    printf 'TARGET_IMAGE_SMOKE_FAILED root-options=%s\n' "$root_options"
    exit 1
    ;;
esac

for volatile_mount in /run /tmp /var/log; do
  mount_type=$(/usr/bin/awk -v path="$volatile_mount" '$2 == path { print $3; exit }' /proc/mounts)
  if [ "$mount_type" != tmpfs ]; then
    printf 'TARGET_IMAGE_SMOKE_FAILED mount=%s type=%s\n' "$volatile_mount" "$mount_type"
    exit 1
  fi
  marker=$volatile_mount/target-image-smoke.$$
  : > "$marker"
  /bin/rm -f "$marker"
done

printf 'TARGET_IMAGE_SMOKE_ROOT options=%s\n' "$root_options"
printf '%s\n' 'TARGET_IMAGE_SMOKE_VOLATILE /run /tmp /var/log writable tmpfs'
if [ ! -f /run/dbus/machine-id ] ||
   ! /usr/bin/dbus-uuidgen --get >/dev/null 2>&1 ||
   ! /usr/bin/dbus-send --system --print-reply --reply-timeout=5000 \
       --dest=org.freedesktop.DBus /org/freedesktop/DBus \
       org.freedesktop.DBus.GetId >/dev/null 2>&1; then
  printf '%s\n' 'TARGET_IMAGE_SMOKE_FAILED dbus-machine-id-or-system-bus'
  exit 1
fi
printf '%s\n' 'TARGET_IMAGE_SMOKE_DBUS machine-id and system bus ready'
printf '%s\n' 'TARGET_IMAGE_SMOKE_READY'
