#!/bin/sh
set -eu

config=${1:-}
case "$config" in
  /*) : ;;
  *)
    printf 'usage: %s ABSOLUTE_MISTER_INI\n' "$0" >&2
    exit 2
    ;;
esac

config_dir=${config%/*}
config_name=${config##*/}
backup=$config.fogcast-backup
tmp=
backup_tmp=

cleanup() {
  [ -z "$tmp" ] || rm -f "$tmp"
  [ -z "$backup_tmp" ] || rm -f "$backup_tmp"
}
trap cleanup EXIT INT TERM

[ -d "$config_dir" ] || {
  printf 'mister-disable-menu-blanking: configuration directory is missing: %s\n' "$config_dir" >&2
  exit 1
}
if [ -e "$config" ] && [ ! -f "$config" ]; then
  printf 'mister-disable-menu-blanking: configuration is not a regular file: %s\n' "$config" >&2
  exit 1
fi
if [ -e "$backup" ] && [ ! -f "$backup" ]; then
  printf 'mister-disable-menu-blanking: backup is not a regular file: %s\n' "$backup" >&2
  exit 1
fi

tmp=$(mktemp "$config_dir/.$config_name.fogcast.XXXXXX")
input=/dev/null
[ ! -f "$config" ] || input=$config

awk '
  function finish_mister() {
    if (!saw_osd_timeout) print "osd_timeout=0"
    if (!saw_video_off) print "video_off=0"
  }

  {
    normalized=$0
    sub(/^[[:space:]]+/, "", normalized)
    sub(/[[:space:]]+$/, "", normalized)

    if (normalized ~ /^\[[^]]+\]$/) {
      if (in_mister) finish_mister()

      section=tolower(normalized)
      in_mister=(section == "[mister]")
      if (in_mister) {
        found_mister=1
        saw_osd_timeout=0
        saw_video_off=0
      }

      print
      next
    }

    assignment=tolower(normalized)
    if (assignment ~ /^osd_timeout[[:space:]]*=/) {
      if (!in_mister || !saw_osd_timeout) print "osd_timeout=0"
      if (in_mister) saw_osd_timeout=1
      next
    }
    if (assignment ~ /^video_off[[:space:]]*=/) {
      if (!in_mister || !saw_video_off) print "video_off=0"
      if (in_mister) saw_video_off=1
      next
    }

    print
  }

  END {
    if (in_mister) finish_mister()
    if (!found_mister) {
      if (NR) print ""
      print "[MiSTer]"
      print "osd_timeout=0"
      print "video_off=0"
    }
  }
' "$input" > "$tmp"
chmod 0644 "$tmp"

if [ -f "$config" ] && cmp -s "$config" "$tmp"; then
  rm -f "$tmp"
  tmp=
  exit 0
fi

if [ -f "$config" ] && [ ! -e "$backup" ]; then
  backup_tmp=$(mktemp "$config_dir/.$config_name.fogcast-backup.XXXXXX")
  cp "$config" "$backup_tmp"
  chmod 0644 "$backup_tmp"
  mv -f "$backup_tmp" "$backup"
  backup_tmp=
  sync
fi
mv -f "$tmp" "$config"
tmp=
sync
