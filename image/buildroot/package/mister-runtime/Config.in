config BR2_PACKAGE_FOGCAST_MISTER_RUNTIME
	bool "mister-runtime"
	depends on BR2_INSTALL_LIBSTDCPP
	help
	  Build and install the pinned native MiSTer runtime daemon from the
	  verified read-only source checkout mounted at /runtime-source.

config BR2_PACKAGE_MISTER_RUNTIME
	bool
	default y if BR2_PACKAGE_FOGCAST_MISTER_RUNTIME
