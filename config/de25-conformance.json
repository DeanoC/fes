{
  "format": 1,
  "note": "Kit D25 conformance steps, run by scripts/de25_conformance.py while a core session is live. Each core lists the package interfaces its steps cover; a declared fes.media.* or fes.mouse.* interface that no step covers is reported as pending. Keys are HID keys sent through the host's confirmed tap; the core owns every character mapping.",
  "cores": {
    "fes.zx81": {
      "steps": [
        {
          "name": "keyboard_reaches_core",
          "covers": [
            "fes.keyboard.hid"
          ],
          "settle": 2,
          "keys": [
            "p"
          ],
          "expect": {
            "idle_max": 0.0001,
            "change": 0.0003
          }
        },
        {
          "keys": [
            "enter"
          ],
          "settle": 3
        },
        {
          "name": "tape_mounts",
          "covers": [
            "fes.media.zx81-tape"
          ],
          "media": [
            "change-tape",
            "zx81-fes-tape-ok.p"
          ]
        },
        {
          "name": "tape_loads",
          "covers": [
            "fes.media.zx81-tape"
          ],
          "settle": 30,
          "keys": [
            "j",
            "shift+p",
            "shift+p",
            "enter"
          ],
          "expect": {
            "ocr": "FES TAPE OK"
          }
        }
      ],
      "not_applicable": {
        "fes.audio.pcm-s16-stereo-48k": "The base ZX81 has no sound hardware: its audio stream carries silence (kit run of #2365 recorded peak RMS 28 through a tape load). Sound comes with the Zon X expansion, which is outside the baseline cell."
      }
    },
