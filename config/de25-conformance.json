    "fes.pcxt-dos": {
      "steps": [
        {
          "name": "freedos_disk_made",
          "cli": [
            "shelf-new",
            "{core_id}",
            "FES F3 {stamp}",
            "{package_id}",
            "freedos"
          ],
          "bind": {
            "game": "game_id",
            "media": "media_id"
          }
        },
        {
          "name": "floppy_mounts",
          "covers": [
            "fes.media.pcxt-floppy"
          ],
          "cli": [
            "insert-library-disk",
            "{game}",
            "{media}"
          ],
          "expect": {
            "units": true
          }
        },
        {
          "name": "freedos_boots",
          "covers": [
            "fes.keyboard.hid",
            "fes.audio.pcm-s16-stereo-48k"
